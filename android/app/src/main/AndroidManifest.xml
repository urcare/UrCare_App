<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google blocks sign-in from inside an embedded WebView, so
                 Google login has to happen in a real browser tab (see
                 signInWithGoogle in src/utils/supabase.ts, which opens it via
                 @capacitor/browser) — this custom-scheme intent filter is
                 what brings the OAuth result back into THIS app afterwards,
                 caught by the appUrlOpen listener in App.tsx. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.urcare.app" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saving the share card image to Documents/UrCare (@capacitor/filesystem)
         needs these only on Android 10 and older; newer Android allows it. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Required for the in-app food-scanner/report-photo camera capture
         (navigator.mediaDevices.getUserMedia in FoodScannerModal.tsx etc.) —
         Capacitor's WebChromeClient explicitly checks for this declaration
         (PermissionHelper.hasDefinedPermission) before it will even attempt
         the runtime camera permission prompt; without it, every camera
         request from the WebView is rejected outright. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Play Store only allows exact alarms for alarm/calendar apps. Plan
         reminders work fine without it (the notification plugin falls back
         to a normal, slightly flexible alarm), so the plugin's request is
         removed here. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Lets the app see installed UPI apps (Android 11+ package visibility),
         so the store checkout's "Pay with UPI app" link (upi://pay...) can
         hand off to GPay / PhonePe / Paytm / BHIM. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>
</manifest>
